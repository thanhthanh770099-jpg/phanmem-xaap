# Cấu hình SMS Brandname VNPT
# Sao chép file này thành server/.env hoặc cài đặt biến môi trường trên Render

VNPT_SMS_URL=http://113.185.0.35:8888/smsbn/api
VNPT_API_USER=vnpt-vnpvlg
VNPT_API_PASS=Vnpt@123
VNPT_USERNAME=vnpt-vnpvlg
VNPT_AGENT_ID=268
VNPT_CONTRACT_ID=495
VNPT_CONTRACT_TYPE_ID=1
VNPT_LABEL_ID=87826
# Mẫu demo hiện tại: 11474554 (Thu nhap {D,30}. Gom: Luong {D,200}. Thuc lanh: {D,20})
# Khi xã đăng ký mẫu phản ánh ý kiến chính thức, thay bằng ID mẫu mới:
VNPT_TEMPLATE_ID=11474554

# Chế độ gửi thử nghiệm:
# true: luôn gửi về SMS_TEST_PHONE (0916167374)
# false: gửi trực tiếp cho số điện thoại người dân phản ánh (sau khi có kinh phí)
SMS_TEST_MODE=true
SMS_TEST_PHONE=84916167374
